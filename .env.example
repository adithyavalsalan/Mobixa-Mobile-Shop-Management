# MOBIXA Environment Configuration
# Copy this file to .env and configure secrets before starting or seeding.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/mobixa
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mobixa?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mobixa

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial Administrator Setup (used by npm run seed)
ADMIN_EMAIL=admin@mobixa.com
ADMIN_PASSWORD=

# Initial Employee Setup (used by npm run seed)
EMPLOYEE_EMAIL=employee@mobixa.com
EMPLOYEE_PASSWORD=
